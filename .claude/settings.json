{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["atlassian"],
  "permissions": {
    "allow": [
      "mcp__atlassian__*",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(buf *)",
      "Bash(sqlc *)",
      "Bash(task *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(kubeconform *)",
      "Bash(actionlint *)",
      "Bash(promtool *)",
      "Bash(docker compose *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(gh auth status)",
      "Bash(gh repo view*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr review * --comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list*)",
      "Bash(gh run view *)",
      "Bash(gh run list*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(git tag *)",
      "Bash(gh label create *)",
      "Bash(kubectl apply *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(docker push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*kubeconfig*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(rm -rf /*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(gh api -X DELETE*)",
      "Bash(kubectl delete *)"
    ]
  }
}
